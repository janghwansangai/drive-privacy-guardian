{
  "manifest_version": 3,
  "name": "개인정보 보안관",
  "version": "0.2.4",
  "description": "구글 드라이브의 공유 권한 점검, 개인정보 점검, 암호화 관리. 구글 외 서버와 통신하지 않습니다.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["identity", "storage", "sidePanel", "alarms"],
  "host_permissions": ["https://www.googleapis.com/*", "https://drive.google.com/*"],
  "side_panel": { "default_path": "viewer.html" },
  "content_scripts": [
    { "matches": ["https://drive.google.com/*"], "js": ["drive_watch.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "web_accessible_resources": [
    { "resources": ["viewer.html"], "matches": ["https://drive.google.com/*"] }
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "개인정보 보안관" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://www.googleapis.com; img-src 'self' blob: data:; base-uri 'none'; form-action 'none'; frame-ancestors https://drive.google.com"
  }
}
